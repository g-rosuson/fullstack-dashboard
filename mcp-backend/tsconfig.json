{
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "types": ["bun"],
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts"]
}
