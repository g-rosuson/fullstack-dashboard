{
    "name": "mern-authentication",
    "version": "1.0.0",
    "scripts": {
        "prepare": "husky install",
        "type-check": "tsc --noEmit",
        "format": "prettier . --write --ignore-path .prettierignore",
        "start:dev": "bash start.sh dev",
        "start:prod": "bash start.sh prod",
        "reset:dev": "bash reset.sh dev",
        "reset:prod": "bash reset.sh prod",
        "test:mcp": "node --test --test-concurrency=1 --test-timeout=600000 tests/mcp/exposure.test.mjs",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@commitlint/cli": "18.6.0",
        "@commitlint/config-conventional": "18.6.0",
        "@playwright/test": "1.59.1",
        "husky": "9.0.10",
        "prettier": "3.2.5"
    }
}
