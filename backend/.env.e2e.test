NODE_ENV=development
# Unprivileged port for E2E on host (CI runners cannot bind :1000 — see docs/guides/e2e-testing.md)
PORT=3000
DEV_CLIENT_URL=http://localhost:5173
DEV_DOMAIN=localhost
ACCESS_TOKEN_SECRET=test-access-token-secret-e2e
REFRESH_TOKEN_SECRET=test-refresh-token-secret-e2e
MONGO_URI=mongodb://127.0.0.1:27017/test?directConnection=true
MONGO_DB_NAME=test-db-e2e
MONGO_JOBS_COLLECTION_NAME=test-jobs-e2e
MONGO_USER_COLLECTION_NAME=test-users-e2e
ENABLE_HTTP_RATE_LIMIT=false
ENABLE_LOGGING=false
ENABLE_REGISTRATION=true
OPENROUTER_API_KEY=test-open-router-api-key
OPENROUTER_MODEL=test-open-router-model
MCP_SERVER_ADDRESS=http://mcp-server:3000/mcp
MCP_SERVER_URL=http://mcp-server:3000/mcp
MONGO_MCP_CONVERSATIONS_COLLECTION_NAME=test-mcp-conversations-e2e
